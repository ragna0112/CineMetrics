{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "index:app",
      "functions": {
        "index.py": {
          "maxDuration": 60,
          "excludeFiles": "{.venv/**,tests/**,data/**,.env,.env.*,**/__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "frontend",
        "path": "/index"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}

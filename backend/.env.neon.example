# Copy to .env.neon for private local cloud maintenance only.
# Enter a DIRECT (no -pooler host) Neon URL in your editor; preserve SSL options.
DATABASE_URL=postgresql://NEON_USER:URL_ENCODED_PASSWORD@ep-PROJECT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
TMDB_TOKEN=
RAW_ARCHIVE_MODE=database
# Not used in database archive mode.
RAW_DATA_DIR=./data/raw
CORS_ORIGINS=https://your-project.vercel.app
